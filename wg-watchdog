2. Script atualizado com Telegram (wg-watchdog.sh)
Bash#!/bin/bash
# =============================================
# WireGuard Watchdog + Notificação Telegram
# =============================================

IP_ALVO="192.168.255.254"
INTERFACE="wg0"
INTERVALO=30
TENTATIVAS=3
TIMEOUT=2
LOG_FILE="/var/log/wg-watchdog.log"

# ================== CONFIGURAÇÃO TELEGRAM ==================
TELEGRAM_TOKEN="SEU_TOKEN_AQUI"          # ← Troque pelo seu token
TELEGRAM_CHAT_ID="SEU_CHAT_ID_AQUI"      # ← Troque pelo seu chat_id
# ===========================================================

# Função para enviar mensagem no Telegram
enviar_telegram() {
    local mensagem="$1"
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" \
        -d chat_id="${TELEGRAM_CHAT_ID}" \
        -d text="${mensagem}" \
        -d parse_mode="HTML" > /dev/null
}

echo "$(date '+%Y-%m-%d %H:%M:%S') - Watchdog iniciado para $IP_ALVO" | tee -a "$LOG_FILE"

while true; do
    if ping -c "$TENTATIVAS" -W "$TIMEOUT" -q "$IP_ALVO" >/dev/null 2>&1; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - $IP_ALVO respondendo normalmente" >> "$LOG_FILE"
    else
        TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
        MENSAGEM="⚠️ <b>WireGuard Reiniciado</b>

IP alvo: <code>$IP_ALVO</code>
Interface: <code>$INTERFACE</code>
Data/Hora: <code>$TIMESTAMP</code>

O gateway parou de responder. Interface wg0 foi reiniciada."

        echo "$TIMESTAMP - $IP_ALVO NÃO respondeu. Reiniciando WireGuard..." | tee -a "$LOG_FILE"

        # Reinicia o WireGuard
        sudo wg-quick down "$INTERFACE" 2>&1 | tee -a "$LOG_FILE"
        sleep 3
        sudo wg-quick up "$INTERFACE" 2>&1 | tee -a "$LOG_FILE"

        echo "$TIMESTAMP - Reinício do wg0 concluído." | tee -a "$LOG_FILE"

        # Envia notificação no Telegram
        enviar_telegram "$MENSAGEM"
    fi

    sleep "$INTERVALO"
done
