Aqui está um shell script simples e eficiente para Linux que faz exatamente o que você pediu:
Toda vez que o IP 192.168.255.254 parar de responder (ping falhar), ele executa:
Bashsudo wg-quick down wg0 && sudo wg-quick up wg0
Script: wg-watchdog.sh
Bash#!/bin/bash
# =============================================
# WireGuard Watchdog - Reinicia wg0 quando o gateway parar de responder
# Alvo: 192.168.255.254
# =============================================

IP_ALVO="192.168.255.254"
INTERFACE="wg0"
INTERVALO=30          # segundos entre verificações
TENTATIVAS=3          # quantas tentativas de ping antes de considerar caído
TIMEOUT=2             # timeout por ping (segundos)
LOG_FILE="/var/log/wg-watchdog.log"

echo "$(date '+%Y-%m-%d %H:%M:%S') - Watchdog iniciado para $IP_ALVO" | tee -a "$LOG_FILE"

while true; do
    if ping -c "$TENTATIVAS" -W "$TIMEOUT" -q "$IP_ALVO" >/dev/null 2>&1; then
        # Tudo ok
        echo "$(date '+%Y-%m-%d %H:%M:%S') - $IP_ALVO respondendo normalmente" >> "$LOG_FILE"
    else
        echo "$(date '+%Y-%m-%d %H:%M:%S') - $IP_ALVO NÃO respondeu após $TENTATIVAS tentativas. Reiniciando WireGuard..." | tee -a "$LOG_FILE"
        
        sudo wg-quick down "$INTERFACE" 2>&1 | tee -a "$LOG_FILE"
        sleep 2
        sudo wg-quick up "$INTERFACE" 2>&1 | tee -a "$LOG_FILE"
        
        echo "$(date '+%Y-%m-%d %H:%M:%S') - Reinício do wg0 concluído." | tee -a "$LOG_FILE"
    fi

    sleep "$INTERVALO"
done
Como usar:

#Salve o script:(cole o conteúdo acima)
nano ~/wg-watchdog.sh

#Dê permissão de execução:
chmod +x ~/wg-watchdog.sh

#Mova para um local adequado (opcional):
sudo mv ~/wg-watchdog.sh /usr/local/bin/wg-watchdog.sh

#Execute o script:
sudo /usr/local/bin/wg-watchdog.sh
#Ou em background:
sudo /usr/local/bin/wg-watchdog.sh >> /var/log/wg-watchdog.log 2>&1 &

Recomendado: Rodar como serviço systemd (mais estável)
Crie o arquivo de serviço:
sudo nano /etc/systemd/system/wg-watchdog.service

#Cole isso:

ini[Unit]
Description=WireGuard Watchdog - Reinicia wg0 quando 192.168.255.254 cair
After=network.target wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/local/bin/wg-watchdog.sh
Restart=always
RestartSec=5
User=root
StandardOutput=append:/var/log/wg-watchdog.log
StandardError=append:/var/log/wg-watchdog.log

[Install]
WantedBy=multi-user.target

#Ative o serviço:
sudo systemctl daemon-reload
sudo systemctl enable --now wg-watchdog.service
sudo systemctl status wg-watchdog.service

